<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Devolutions.AgentSkills</AssemblyName>
    <!-- The core keeps the CLI's `Skills` namespace (internal); the public API
         lives in `Devolutions.AgentSkills`. -->
    <RootNamespace>Skills</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Consumers (UniGetUI) publish with full trimming and NativeAOT: run the
         trim, AOT and single-file analyzers on every build, warnings as errors. -->
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <Version>0.1.0</Version>
    <PackageId>Devolutions.AgentSkills</PackageId>
    <Authors>Devolutions</Authors>
    <Description>Install, list, update and remove agent skills (SKILL.md folders) for Claude Code, Codex, Cursor, GitHub Copilot and about 75 other coding agents. Compatible with the skills CLI (vercel-labs/skills) and skills.sh: same install locations, lock files and sources.</Description>
    <PackageTags>agent-skills;skills;skills.sh;claude-code;codex;cursor;copilot;ai-agents</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the AOT-safe YamlStream API is used. 17.0.1 is the floor (UniGetUI
         references it); NuGet picks the highest version in the graph. -->
    <PackageReference Include="YamlDotNet" Version="17.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- The CLI (assembly `skills`) and the tests are built on the internal core. -->
    <InternalsVisibleTo Include="skills" />
    <InternalsVisibleTo Include="Skills.Tests" />
  </ItemGroup>

</Project>
